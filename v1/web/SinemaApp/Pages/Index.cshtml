@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="row mb-4">
    <div class="col-md-3 col-6 mb-3">
        <div class="card ozet-kart"><div class="card-body">
            <div class="baslik">Vizyondaki Film</div>
            <div class="sayi">@Model.FilmSayisi</div>
        </div></div>
    </div>
    <div class="col-md-3 col-6 mb-3">
        <div class="card ozet-kart"><div class="card-body">
            <div class="baslik">7 Günlük Gösterim</div>
            <div class="sayi">@Model.BugunkuGosterim</div>
        </div></div>
    </div>
    <div class="col-md-3 col-6 mb-3">
        <div class="card ozet-kart"><div class="card-body">
            <div class="baslik">Aktif Rezervasyon</div>
            <div class="sayi">@Model.AktifRezervasyon</div>
        </div></div>
    </div>
    <div class="col-md-3 col-6 mb-3">
        <div class="card ozet-kart"><div class="card-body">
            <div class="baslik">Toplam Hasılat</div>
            <div class="sayi text-success">@Bicim.Para(Model.ToplamHasilat)</div>
        </div></div>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Yaklaşan Gösterimler</h5>
            <a asp-page="/Gosterimler/Index" class="small">Tümü &raquo;</a>
        </div>
        <table class="table table-sm table-hover">
            <thead class="thead-light">
                <tr><th>Tarih</th><th>Film</th><th>Sinema / Salon</th><th>Boş</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (DataRow g in Model.YaklasanGosterimler.Rows)
                {
                    <tr>
                        <td>@Bicim.Tarih(g["tarih"]) <b>@Bicim.Saat(g["baslangic_saati"])</b></td>
                        <td>@g["film_adi"]</td>
                        <td class="small">@g["sinema_adi"]<br />@g["salon_adi"]</td>
                        <td>@g["bos_koltuk"]</td>
                        <td><a asp-page="/Gosterimler/Bilet" asp-route-id="@g["gosterim_no"]" class="btn btn-sm btn-primary">Bilet</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-lg-5 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Son Rezervasyonlar</h5>
            <a asp-page="/Rezervasyonlar/Index" class="small">Tümü &raquo;</a>
        </div>
        <ul class="list-group">
            @foreach (DataRow r in Model.SonRezervasyonlar.Rows)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <div>@r["musteri"]</div>
                        <small class="text-muted">@r["film_adi"] &middot; Koltuk @Bicim.Koltuk(r["koltuk_no"])</small>
                    </div>
                    <span class="badge badge-@Bicim.DurumRenk(r["odeme_durumu"])">@Bicim.DurumYazi(r["odeme_durumu"])</span>
                </li>
            }
        </ul>
    </div>
</div>
