@page "{id:int?}"
@model SinemaApp.Pages.Filmler.DuzenleModel
@{
    ViewData["Title"] = Model.YeniKayit ? "Yeni Film" : "Film Düzenle";
    var turler = new[] { "Aksiyon", "Animasyon", "Bilim Kurgu", "Belgesel", "Dram", "Fantastik",
                         "Gerilim", "Komedi", "Korku", "Macera", "Romantik", "Suç" };
}

<h2>@ViewData["Title"]</h2>

<div class="card" style="max-width: 600px">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Film.FilmNo" />

            <div class="form-group">
                <label>Film Adı</label>
                <input asp-for="Film.Ad" class="form-control" />
                <span asp-validation-for="Film.Ad" class="text-danger small"></span>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Tür</label>
                    <select asp-for="Film.Tur" class="form-control">
                        <option value="">-- seçiniz --</option>
                        @foreach (var t in turler)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                    <span asp-validation-for="Film.Tur" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-6">
                    <label>Süre (dakika)</label>
                    <input asp-for="Film.SureDk" type="number" class="form-control" />
                    <span asp-validation-for="Film.SureDk" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-group">
                <label>Gösterime Giriş Tarihi</label>
                <input asp-for="Film.VizyonTarihi" class="form-control" />
            </div>

            <button class="btn btn-primary">Kaydet</button>
            <a asp-page="Index" class="btn btn-link">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
