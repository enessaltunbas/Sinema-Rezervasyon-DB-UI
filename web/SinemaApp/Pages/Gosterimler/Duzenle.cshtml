@page "{id:int?}"
@model SinemaApp.Pages.Gosterimler.DuzenleModel
@{
    ViewData["Title"] = Model.YeniKayit ? "Yeni Gösterim" : "Gösterim Düzenle";
}

<h2>@ViewData["Title"]</h2>

<div class="card" style="max-width: 640px">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="list-style:none"></div>
            <input type="hidden" asp-for="Gosterim.GosterimNo" />

            <div class="form-group">
                <label>Film</label>
                <select asp-for="Gosterim.FilmNo" class="form-control">
                    <option value="0">-- film seçiniz --</option>
                    @foreach (DataRow f in Model.Filmler.Rows)
                    {
                        <option value="@f["film_no"]">@f["ad"] (@f["sure_dk"] dk, vizyon: @Bicim.Tarih(f["vizyon_tarihi"]))</option>
                    }
                </select>
                <span asp-validation-for="Gosterim.FilmNo" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label>Sinema / Salon</label>
                <select asp-for="Gosterim.Salon" class="form-control">
                    <option value="">-- salon seçiniz --</option>
                    @foreach (DataRow s in Model.Salonlar.Rows)
                    {
                        <option value="@s["deger"]">@s["sinema_adi"] - @s["salon_adi"] (@s["kapasite"] kişi)</option>
                    }
                </select>
                <span asp-validation-for="Gosterim.Salon" class="text-danger small"></span>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label>Tarih</label>
                    <input asp-for="Gosterim.Tarih" class="form-control" />
                </div>
                <div class="form-group col-md-4">
                    <label>Başlangıç Saati</label>
                    <input asp-for="Gosterim.Saat" class="form-control" />
                </div>
                <div class="form-group col-md-4">
                    <label>Bilet Fiyatı (₺)</label>
                    <input asp-for="Gosterim.Fiyat" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Gosterim.Fiyat" class="text-danger small"></span>
                </div>
            </div>

            <p class="small text-muted">
                Not: Aynı salonda film süresi + 15 dk temizlik süresi içinde başka gösterim varsa kayıt yapılmaz.
            </p>

            <button class="btn btn-primary">Kaydet</button>
            <a asp-page="Index" class="btn btn-link">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
