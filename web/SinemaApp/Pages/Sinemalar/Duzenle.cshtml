@page "{id:int?}"
@model SinemaApp.Pages.Sinemalar.DuzenleModel
@{
    ViewData["Title"] = Model.YeniKayit ? "Yeni Sinema" : Model.Sinema.Ad;
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-lg-5 mb-4">
        <div class="card">
            <div class="card-header bg-white"><b>Sinema Bilgileri</b></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Kaydet">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Sinema.SinemaNo" />
                    <div class="form-group">
                        <label>Sinema Adı</label>
                        <input asp-for="Sinema.Ad" class="form-control" />
                        <span asp-validation-for="Sinema.Ad" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label>Adres</label>
                        <textarea asp-for="Sinema.Adres" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Sinema.Adres" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label>Şehir</label>
                        <input asp-for="Sinema.Sehir" class="form-control" />
                        <span asp-validation-for="Sinema.Sehir" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-primary">Kaydet</button>
                    <a asp-page="Index" class="btn btn-link">Geri</a>
                </form>
            </div>
        </div>

        @if (!Model.YeniKayit)
        {
            <div class="card mt-4">
                <div class="card-header bg-white"><b>Telefonlar</b></div>
                <ul class="list-group list-group-flush">
                    @foreach (DataRow t in Model.Telefonlar.Rows)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @t["telefon"]
                            <form method="post" asp-page-handler="TelefonSil" asp-route-id="@Model.Sinema.SinemaNo">
                                <input type="hidden" name="telefon" value="@t["telefon"]" />
                                <button class="btn btn-sm btn-link text-danger p-0">kaldır</button>
                            </form>
                        </li>
                    }
                </ul>
                <div class="card-body">
                    <form method="post" asp-page-handler="TelefonEkle" asp-route-id="@Model.Sinema.SinemaNo" class="form-inline">
                        <input name="telefon" class="form-control form-control-sm mr-2" placeholder="0212 000 00 00" />
                        <button class="btn btn-sm btn-outline-success">Ekle</button>
                    </form>
                </div>
            </div>
        }
    </div>

    @if (!Model.YeniKayit)
    {
        <div class="col-lg-7 mb-4">
            <div class="card">
                <div class="card-header bg-white"><b>Salonlar</b></div>
                <table class="table mb-0">
                    <thead class="thead-light">
                        <tr><th>No</th><th>Ad</th><th>Kapasite</th><th>Gösterim</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow s in Model.Salonlar.Rows)
                        {
                            var formId = "salon" + s["salon_no"];
                            <tr>
                                <td>@s["salon_no"]</td>
                                <td><input name="salonAd" form="@formId" value="@s["ad"]" class="form-control form-control-sm" /></td>
                                <td style="width:110px"><input name="kapasite" form="@formId" type="number" value="@s["kapasite"]" class="form-control form-control-sm" /></td>
                                <td>@s["gosterim_sayisi"]</td>
                                <td class="text-nowrap text-right">
                                    <form method="post" id="@formId" asp-page-handler="SalonGuncelle" asp-route-id="@Model.Sinema.SinemaNo" class="d-inline">
                                        <input type="hidden" name="salonNo" value="@s["salon_no"]" />
                                        <button class="btn btn-sm btn-outline-primary">Kaydet</button>
                                    </form>
                                    <form method="post" asp-page-handler="SalonSil" asp-route-id="@Model.Sinema.SinemaNo" class="d-inline"
                                          onsubmit="return confirm('Salon silinsin mi?');">
                                        <input type="hidden" name="salonNo" value="@s["salon_no"]" />
                                        <button class="btn btn-sm btn-outline-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="card-body border-top">
                    <form method="post" asp-page-handler="SalonEkle" asp-route-id="@Model.Sinema.SinemaNo" class="form-inline">
                        <input name="salonAd" class="form-control form-control-sm mr-2 mb-1" placeholder="Salon adı" />
                        <input name="kapasite" type="number" min="1" max="500" class="form-control form-control-sm mr-2 mb-1" placeholder="Kapasite" required />
                        <button class="btn btn-sm btn-success mb-1">+ Salon Ekle</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
