@page
@model SinemaApp.Pages.Rezervasyonlar.IndexModel
@{
    ViewData["Title"] = "Rezervasyonlar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Rezervasyonlar</h2>
    <a asp-page="/Gosterimler/Index" class="btn btn-success">+ Bilet Sat</a>
</div>

<form method="get" class="form-inline mb-3">
    <select asp-for="Durum" class="form-control mr-2">
        <option value="">Tüm durumlar</option>
        <option value="Beklemede">Beklemede</option>
        <option value="Odendi">Ödendi</option>
        <option value="Iptal">İptal</option>
    </select>
    <input asp-for="Ara" class="form-control mr-2" placeholder="Müşteri, film veya rez. no" />
    <button class="btn btn-outline-secondary">Filtrele</button>
</form>

<table class="table table-hover table-sm">
    <thead class="thead-light">
        <tr>
            <th>No</th>
            <th>Müşteri</th>
            <th>Film / Salon</th>
            <th>Seans</th>
            <th>Koltuk</th>
            <th>Ücret</th>
            <th>Rez. Tarihi</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Rezervasyonlar.Rows.Count == 0)
        {
            <tr><td colspan="9" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
        }
        @foreach (DataRow r in Model.Rezervasyonlar.Rows)
        {
            var durum = r["odeme_durumu"].ToString();
            var vurgu = Model.Vurgula != null && Model.Vurgula.ToString() == r["rezervasyon_no"].ToString() ? "table-info" : "";
            <tr class="@vurgu">
                <td>@r["rezervasyon_no"]</td>
                <td><a asp-page="/Musteriler/Duzenle" asp-route-id="@r["musteri_no"]">@r["musteri"]</a></td>
                <td>@r["film_adi"]<br /><small class="text-muted">@r["sinema_adi"] - @r["salon_adi"]</small></td>
                <td>@Bicim.Tarih(r["tarih"]) @Bicim.Saat(r["baslangic_saati"])</td>
                <td><b>@Bicim.Koltuk(r["koltuk_no"])</b></td>
                <td>@Bicim.Para(r["ucret"])</td>
                <td class="small">@Bicim.TarihSaat(r["rezervasyon_tarihi"])</td>
                <td><span class="badge badge-@Bicim.DurumRenk(durum)">@Bicim.DurumYazi(durum)</span></td>
                <td class="text-right text-nowrap">
                    @if (durum == "Beklemede")
                    {
                        <form method="post" asp-page-handler="Odeme" asp-route-id="@r["rezervasyon_no"]" asp-route-durum="@Model.Durum" asp-route-ara="@Model.Ara" class="d-inline">
                            <button class="btn btn-sm btn-success">Ödeme Al</button>
                        </form>
                    }
                    @if (durum != "Iptal")
                    {
                        <form method="post" asp-page-handler="Iptal" asp-route-id="@r["rezervasyon_no"]" asp-route-durum="@Model.Durum" asp-route-ara="@Model.Ara" class="d-inline"
                              onsubmit="return confirm('Rezervasyon iptal edilsin mi?');">
                            <button class="btn btn-sm btn-outline-danger">İptal</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
